---
interface Post { id: string; data: { title: string; date: Date; description?: string; tags: string[] } }
interface Props { posts: Post[]; base: string; empty?: string; warm?: boolean }
const { posts, base, empty = 'Nothing here yet.', warm = false } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

{posts.length === 0 ? (
  <p class="muted">{empty}</p>
) : (
  <ul class="posts">
    {posts.map((p) => (
      <li>
        <a href={`${base}${p.id}/`}>
          <time class="mono muted" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
          <span class="t">{p.data.title}</span>
          {p.data.description && <span class="d muted">{p.data.description}</span>}
          {p.data.tags.length > 0 && (
            <span class="tags">{p.data.tags.map((t) => <span class:list={['tag', { warm }]}>{t}</span>)}</span>
          )}
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .posts { list-style: none; padding: 0; margin: 0; }
  .posts li + li { border-top: 1px solid var(--line); }
  .posts a {
    display: grid; gap: 6px; padding: 20px 0; color: inherit; text-decoration: none;
  }
  .posts a:hover .t { color: var(--accent); }
  time { font-size: 0.78rem; }
  .t { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; line-height: 1.25; transition: color .15s; }
  .d { font-size: 0.95rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 2px; }
</style>
