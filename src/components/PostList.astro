---
interface Post { id: string; data: { title: string; date: Date; description?: string; tags: string[] } }
interface Props { posts: Post[]; base: string; empty?: string }
const { posts, base, empty = 'No posts yet.' } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

{posts.length === 0 ? (
  <p class="muted">{empty}</p>
) : (
  <ul class="entries">
    {posts.map((p) => (
      <li>
        <time class="yr" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
        <div>
          <a href={`${base}${p.id}/`}>{p.data.title}</a>
          {p.data.description && <p class="muted small">{p.data.description}</p>}
          {p.data.tags.length > 0 && <p class="pills">{p.data.tags.map((t) => <span class="tag">{t}</span>)}</p>}
        </div>
      </li>
    ))}
  </ul>
)}

<style>
  .pills { margin-top: 6px; }
</style>
