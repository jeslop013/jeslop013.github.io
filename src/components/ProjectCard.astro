---
import { span, type Project } from '../data/cv';
interface Props { project: Project }
const { project: p } = Astro.props;
---

<li id={p.id}>
  <span class="yr">{span(p)}</span>
  <div>
    <strong>{p.link ? <a href={p.link}>{p.title}</a> : p.title}</strong>
    <p class="muted small">{p.role}. {p.where}.</p>
    <p>{p.summary}</p>
  </div>
</li>

<style>
  li { scroll-margin-top: 24px; }
</style>
