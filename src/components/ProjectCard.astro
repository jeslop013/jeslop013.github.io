---
import type { Project } from '../data/cv';
import ProjectFigure from './ProjectFigure.astro';
interface Props { project: Project; flip?: boolean; compact?: boolean }
const { project: p, flip = false, compact = false } = Astro.props;
---

<article class:list={['project', { flip, compact }]} id={p.id}>
  <div class="text">
    <p class="eyebrow">{p.years} · {p.role}</p>
    <h3>{p.title}<span class="sub">{p.subtitle}</span></h3>
    <p class="where muted">{p.where}</p>
    <p>{p.summary}</p>
    {!compact && p.highlights && (
      <ul class="hl">{p.highlights.map((h) => <li>{h}</li>)}</ul>
    )}
    <div class="meta">
      {p.links?.map((l) => (l.href ? <a class="link" href={l.href} target="_blank" rel="noopener">{l.label} ↗</a> : <span class="link off">{l.label}</span>))}
    </div>
    <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
  </div>
  <figure>
    <ProjectFigure name={p.figure} />
    <figcaption>{p.figureCaption}</figcaption>
  </figure>
</article>

<style>
  .project {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    padding: 32px 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 80px;
  }
  @media (min-width: 860px) {
    .project { grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; }
    .project.flip .text { order: 2; }
  }
  h3 { font-size: 1.6rem; margin-bottom: 4px; }
  .sub { display: block; font-family: var(--font-body); font-size: 1rem; font-weight: 500; color: var(--muted); margin-top: 6px; letter-spacing: 0; }
  .where { font-size: 0.9rem; margin-bottom: 14px; }
  .hl { padding-left: 1.1em; margin: 0 0 16px; font-size: 0.93rem; color: var(--muted); }
  .hl li { margin: 4px 0; }
  .hl li::marker { color: var(--accent); }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-bottom: 12px; }
  .link { font-weight: 500; font-size: 0.93rem; }
  .link.off { color: var(--muted); font-style: italic; font-weight: 400; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  figure { margin: 0; }
  figcaption { font-size: 0.82rem; color: var(--muted); margin-top: 8px; line-height: 1.45; }
  .compact h3 { font-size: 1.3rem; }
</style>
