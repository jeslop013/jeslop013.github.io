---
import 'katex/dist/katex.min.css';
import Base from './Base.astro';

interface Props {
  title: string;
  date: Date;
  description?: string;
  tags: string[];
  section: { label: string; href: string };
  lang?: 'en' | 'es';
  // Link to the same post in the other language, if it exists.
  translation?: { lang: 'en' | 'es'; href: string };
}
const { title, date, description, tags, section, lang = 'en', translation } = Astro.props;
const fmt = date.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={title} description={description} lang={lang}>
  <article>
    <p class="top small">
      <a href={section.href}>← {section.label}</a>
      {translation && (
        <span class="langs">
          {lang === 'en' ? <strong>English</strong> : <a href={translation.href} hreflang="en">English</a>}
          {' | '}
          {lang === 'es' ? <strong>Español</strong> : <a href={translation.href} hreflang="es">Español</a>}
        </span>
      )}
    </p>
    <h1>{title}</h1>
    <p class="muted small"><time datetime={date.toISOString()}>{fmt}</time></p>
    {tags.length > 0 && <p class="pills">{tags.map((t) => <span class="tag">{t}</span>)}</p>}
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .top { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .pills { margin-bottom: 24px; }
</style>
