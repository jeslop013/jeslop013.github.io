---
import 'katex/dist/katex.min.css';
import Base from './Base.astro';

interface Props {
  title: string;
  date: Date;
  description?: string;
  tags: string[];
  section: { label: string; href: string };
}
const { title, date, description, tags, section } = Astro.props;
const fmt = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={title} description={description}>
  <article class="container post">
    <header>
      <a class="back mono" href={section.href}>← {section.label}</a>
      <time class="mono muted" datetime={date.toISOString()}>{fmt}</time>
      <h1>{title}</h1>
      {description && <p class="lede muted">{description}</p>}
      {tags.length > 0 && <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .post { padding-top: 40px; padding-bottom: 40px; }
  .post header, .post .prose { max-width: var(--prose); margin-left: auto; margin-right: auto; }
  .back { display: inline-block; margin-bottom: 32px; font-size: 0.82rem; color: var(--muted); text-decoration: none; }
  .back:hover { color: var(--accent); }
  header { margin-bottom: 40px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
  time { font-size: 0.82rem; }
  h1 { margin-top: 10px; }
  .lede { font-size: 1.15rem; }
  .tags { display: flex; gap: 6px; flex-wrap: wrap; }
</style>
