---
import { getCollection, render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { langOf, counterpartId } from '../../data/lang';

export async function getStaticPaths() {
  const posts = await getCollection('science', ({ data }) => !data.draft);
  const ids = new Set(posts.map((p) => p.id));
  return posts.map((post) => {
    const other = counterpartId(post.id);
    const lang = langOf(post.id);
    const translation = ids.has(other) ? { lang: lang === 'en' ? 'es' : 'en', href: `/science/${other}/` } : undefined;
    return { params: { id: post.id }, props: { post, lang, translation } };
  });
}
const { post, lang, translation } = Astro.props;
const { Content } = await render(post);
---

<Post {...post.data} lang={lang} translation={translation} section={{ label: 'Science', href: lang === 'es' ? '/science/?lang=es' : '/science/' }}>
  <Content />
</Post>
