---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE } from '../config';
import {
  span, isCurrent, projects, publications, positions, education, talks, teaching, furtherEducation, outreach, skills,
} from '../data/cv';

const me = 'J. A. Moreno López';
const boldMe = (s: string) => s.replace(me, `<strong>${me}</strong>`);
const current = projects.filter(isCurrent);
const past = projects.filter((p) => !isCurrent(p));
const toc = [
  ['positions', 'Positions'], ['education', 'Education'], ['publications', 'Publications'], ['projects', 'Projects'],
  ['talks', 'Talks'], ['teaching', 'Teaching'], ['further', 'Further education'], ['outreach', 'Outreach'], ['skills', 'Skills'],
];
---

<Base title="CV" description={`Curriculum vitae of ${SITE.name}.`}>
  <h1>Curriculum vitae</h1>
  <p class="actions">
    <a class="btn" href={SITE.links[0].href}>Google Scholar</a>
    {SITE.cvPdf && <a class="btn primary" href={SITE.cvPdf} download>Download PDF</a>}
  </p>
  <nav class="pills" aria-label="CV sections">
    {toc.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
  </nav>

  <h2 id="positions">Positions</h2>
  <ul class="entries">
    {positions.map((x) => (
      <li><span class="yr">{span(x)}</span><div><strong>{x.title}</strong>, {x.where}{x.note && <p class="muted small">{x.note}</p>}</div></li>
    ))}
  </ul>

  <h2 id="education">Education</h2>
  <ul class="entries">
    {education.map((x) => (
      <li><span class="yr">{span(x)}</span><div><strong>{x.title}</strong>, {x.where}{x.note && <p class="muted small">{x.note}</p>}</div></li>
    ))}
  </ul>

  <h2 id="publications">Publications</h2>
  <ul class="entries">
    {publications.map((p) => (
      <li>
        <span class="yr">{p.year}</span>
        <div>
          {p.doi ? <a href={`https://doi.org/${p.doi}`}>{p.title}</a> : <span>{p.title}</span>}
          <p class="muted small" set:html={boldMe(p.authors)} />
          <p class="small"><em>{p.venue}</em></p>
        </div>
      </li>
    ))}
  </ul>

  <h2 id="projects">Projects</h2>
  {current.length > 0 && (
    <>
      <h3 class="sub">Current</h3>
      <ul class="entries">{current.map((p) => <ProjectCard project={p} />)}</ul>
    </>
  )}
  {past.length > 0 && (
    <>
      <h3 class="sub">Past</h3>
      <ul class="entries">{past.map((p) => <ProjectCard project={p} />)}</ul>
    </>
  )}

  <h2 id="talks">Talks</h2>
  <ul class="entries">
    {talks.map((t) => (
      <li><span class="yr">{t.year}</span><div>{t.title}<p class="muted small">{t.kind}. {t.where}.</p></div></li>
    ))}
  </ul>

  <h2 id="teaching">Teaching</h2>
  <ul class="entries">
    {teaching.map((x) => (
      <li><span class="yr">{span(x)}</span><div>{x.title}<p class="muted small">{x.where}</p></div></li>
    ))}
  </ul>

  <h2 id="further">Further education</h2>
  <ul class="entries">
    {furtherEducation.map((x) => (
      <li><span class="yr">{x.year}</span><div>{x.title}<p class="muted small">{x.where}.{x.note && ` ${x.note}`}</p></div></li>
    ))}
  </ul>

  <h2 id="outreach">Outreach</h2>
  <ul class="entries">
    {outreach.map((o) => (
      <li><span class="yr">{o.year}</span><div>{o.href ? <a href={o.href}>{o.title}</a> : o.title}<p class="muted small">{o.note}</p></div></li>
    ))}
  </ul>

  <h2 id="skills">Skills</h2>
  <ul class="entries">
    {skills.map((s) => <li><span class="yr">{s.label}</span><div>{s.value}</div></li>)}
  </ul>
</Base>

<style>
  .actions { display: flex; gap: 8px; }
  h2 { scroll-margin-top: 16px; }
  .sub { font-size: 0.85rem; font-weight: 500; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; margin: 16px 0 0; }
</style>
