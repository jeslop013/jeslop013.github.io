---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

// Loose feed. Posts with `short: true` show their full text here.
// Other posts show title + description and link to their own page.
const posts = (await getCollection('variety', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const items = await Promise.all(
  posts.map(async (p) => ({ post: p, Content: p.data.short ? (await render(p)).Content : null })),
);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title="Variety" description="Thoughts about whatever.">
  <h1>Variety</h1>
  <p class="muted">Thoughts. Not always about science.</p>

  {items.length === 0 && <p class="muted">No posts yet.</p>}
  <div class="feed">
    {items.map(({ post, Content }) => (
      <article>
        <p class="muted small"><time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time></p>
        <h3>{Content ? post.data.title : <a href={`/variety/${post.id}/`}>{post.data.title}</a>}</h3>
        {Content ? <div class="prose"><Content /></div> : post.data.description && <p>{post.data.description}</p>}
        {post.data.tags.length > 0 && <p class="pills">{post.data.tags.map((t) => <span class="tag">{t}</span>)}</p>}
      </article>
    ))}
  </div>
</Base>

<style>
  .feed article { padding: 16px 0; border-bottom: 1px solid var(--line); }
  .feed h3 { margin: 0 0 6px; }
  .feed .prose :global(p:last-child) { margin-bottom: 0.6em; }
</style>
