---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AgentField from '../components/AgentField.astro';
import ProjectFigure from '../components/ProjectFigure.astro';
import PostList from '../components/PostList.astro';
import BlueskyFeed from '../components/BlueskyFeed.astro';
import Email from '../components/Email.astro';
import { SITE } from '../config';
import { themes, hobbies } from '../data/cv';
import { langOf } from '../data/lang';

const science = (await getCollection('science', ({ id, data }) => !data.draft && langOf(id) === 'en'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base>
  <section class="intro">
    <img src={SITE.photo} alt={`Portrait of ${SITE.name}`} width="160" height="200" />
    <div>
      <h1>{SITE.name}</h1>
      <p class="muted">PhD. {SITE.role}.</p>
      <p>
        I model urban systems. I use sensitivity analysis and risk management to validate complex models and
        simulations. I make the results usable for evidence-based policy-making.
      </p>
      <p>
        Current work: complex-systems modeling and uncertainty analysis in the{' '}
        <a href="https://github.com/fbk-most/civic-digital-twins">Civic Digital Twins</a> framework, agent-based
        mobility simulators, and experiments on cooperative dilemmas with AI.
      </p>
      <p class="actions">
        <a class="btn primary" href="/cv/">CV</a>
        <Email label="Email" class="btn" />
      </p>
      <p class="pills">
        {SITE.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </p>
    </div>
  </section>

  <section>
    <div class="field"><AgentField /></div>
    <p class="muted small caption">
      A toy metro. Commuters travel between random stations. An infection spreads on trains and platforms (SIRS: immunity does not last).    </p>
  </section>

  <section>
    <h2>Research themes</h2>
    <div class="themes">
      {themes.map((t) => (
        <div class="card theme">
          <ProjectFigure name={t.figure} />
          <h3>{t.title}</h3>
          <p>{t.text}</p>
          <p class="pills">{t.links.map((l) => <a href={l.href}>{l.label}</a>)}</p>
        </div>
      ))}
    </div>
  </section>

  {science.length > 0 && (
    <section>
      <h2>Science</h2>
      <PostList posts={science} base="/science/" />
      <p class="small"><a href="/science/">All posts →</a></p>
    </section>
  )}

  <section>
    <h2>Bluesky</h2>
    <BlueskyFeed limit={4} />
  </section>

  <section>
    <h2>Outside work</h2>
    <div class="cards">
      {hobbies.map((h) => (
        <div class="card">
          <span class="icon" aria-hidden="true">{h.icon}</span>
          <h3>{h.title}</h3>
          <p>{h.text}</p>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .intro { display: grid; gap: 24px; grid-template-columns: 1fr; margin-top: 16px; }
  @media (min-width: 640px) { .intro { grid-template-columns: 160px 1fr; } }
  .intro img { width: 160px; aspect-ratio: 4 / 5; object-fit: cover; object-position: 18% 60%; border-radius: var(--radius); }
  .intro h1 { margin-bottom: 0.2em; }
  .actions { display: flex; gap: 8px; margin: 20px 0 12px; }
  .field { margin-top: 32px; }
  .caption { margin-top: 6px; }
  .themes { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); }
  .theme .pills { margin-top: 10px; }
  .icon { font-size: 1.4rem; }
</style>
